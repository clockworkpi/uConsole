#!/bin/bash
set -euo pipefail

if (( $# < 4 || $# > 5 )); then
    echo "Usage: $0 <serial_port> <altID> <usbID> <binfile> [dfuse_address]" >&2
    exit 2
fi

DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
case "$1" in
    /dev/*) serial_port=$1 ;;
    *) serial_port=/dev/$1 ;;
esac
altID=$2
usbID=$3
binfile=$4
if [[ ! -f "$binfile" || ! -r "$binfile" || ! -s "$binfile" ]]; then
    echo "Firmware must be a readable, nonempty file: $binfile" >&2
    exit 2
fi

# A release bundle always carries its native helper at the root. Fall back to
# the legacy Debian layout so existing checked-out/prebuilt bundles keep working.
architecture=$(uname -m)
if command -v dpkg >/dev/null 2>&1; then
    architecture=$(dpkg --print-architecture) || architecture=$(uname -m)
fi
if [[ -x $DIR/upload-reset ]]; then
    reset_default=$DIR/upload-reset
else
    case "$architecture" in
        amd64|x86_64) reset_default=$DIR/upload-reset.elf ;;
        arm64|aarch64) reset_default=$DIR/deb_packages/aarch64/upload-reset.elf ;;
        armhf|arm|armv6l|armv7l) reset_default=$DIR/deb_packages/armhf/upload-reset.elf ;;
        riscv64) reset_default=$DIR/deb_packages/riscv64/upload-reset.elf ;;
        *)
            if [[ -z ${UPLOAD_RESET:-} ]]; then
                echo "Unsupported architecture: $architecture; set UPLOAD_RESET to a native helper." >&2
                exit 2
            fi
            reset_default=$UPLOAD_RESET
            ;;
    esac
fi
reset_tool=${UPLOAD_RESET:-$reset_default}
dfu_default=$(command -v dfu-util 2>/dev/null || true)
dfu_tool=${DFU_UTIL:-${dfu_default:-/usr/bin/dfu-util}}
for tool in "$reset_tool" "$dfu_tool"; do
    if [[ ! -x "$tool" ]]; then
        echo "Required executable not found: $tool" >&2
        exit 2
    fi
done

# A keyboard already in DFU mode may have no serial interface. Allow reset
# failures, but require dfu-util itself to succeed before reporting an upload.
for attempt in 1 2; do
    if ! "$reset_tool" "$serial_port" 750; then
        echo "Serial reset attempt $attempt failed; checking DFU mode next." >&2
    fi
    if (( attempt == 1 )); then sleep 2; fi
done

args=(-d "$usbID" -a "$altID" -D "$binfile")
if (( $# == 5 )); then args+=(--dfuse-address "$5"); fi
if "$dfu_tool" "${args[@]}" -R; then
    echo "DFU upload completed; waiting for $serial_port..."
else
    result=$?
    echo "DFU upload failed (exit $result). Check USB connection and bootloader mode." >&2
    exit "$result"
fi

for ((attempt=0; attempt<40; attempt++)); do
    if [[ -c "$serial_port" ]]; then
        echo "Done: serial device returned."
        exit 0
    fi
    sleep 0.2
done
echo "DFU upload completed, but $serial_port did not return within 8 seconds." >&2
exit 1
