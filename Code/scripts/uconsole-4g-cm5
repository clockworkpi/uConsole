#!/bin/sh
# Power control for the uConsole CM5 4G extension (libgpiod 2.x).
set -eu

usage() {
    echo "Usage: $0 enable|disable"
    echo "Requires gpioset from libgpiod 2.x and access to /dev/gpiochip0."
}

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi
case "$1" in
    help|--help|-h) usage; exit 0 ;;
    enable|disable) ;;
    *) usage >&2; exit 2 ;;
esac

if ! command -v gpioset >/dev/null 2>&1; then
    echo "Install gpioset from libgpiod 2.x before controlling the modem." >&2
    exit 1
fi
# Version 1 uses incompatible options; reject it before touching GPIO lines.
case "$(gpioset --version)" in
    *" v2."*) ;;
    *) echo "This script requires gpioset from libgpiod 2.x." >&2; exit 1 ;;
esac

case "$1" in
    enable)
        echo "Power on 4G module on uConsole CM5"
        gpioset -t0 -p2s -c gpiochip0 24=1
        gpioset -t0 -p2s -c gpiochip0 15=1
        sleep 5
        gpioset -t0 -p2s -c gpiochip0 15=0
        echo "Waiting for modem initialization..."
        sleep 20
        ;;
    disable)
        echo "Power off 4G module on uConsole CM5"
        gpioset -t0 -p1s -c gpiochip0 24=0
        gpioset -t0 -p5s -c gpiochip0 24=1
        gpioset -t0 -p20s -c gpiochip0 24=0
        sleep 5
        ;;
esac

echo "Power sequence complete."
echo "If using ModemManager, run mmcli -L to check modem detection."
