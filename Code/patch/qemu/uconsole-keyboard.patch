+static void reply(USBPacket *p, uint8_t *data, int length,
+                  const uint8_t *source, unsigned size)
+{
+    p->actual_length = MIN(length, size);
+    memcpy(data, source, p->actual_length);
+}
+
+static void uconsole_reset(USBDevice *dev)
+{
+    UConsoleUSB *s = USB_UCONSOLE(dev);
+    s->head = s->count = s->rx_used = 0;
+    s->epoch++;
+    usb_desc_init(dev);
+    /* USB bus reset clears transport queues, not firmware line-coding/DTR state. */
+}
+
+static void uconsole_control(USBDevice *dev, USBPacket *p, int request,
+                             int value, int index, int length, uint8_t *data)
+{
+    UConsoleUSB *s = USB_UCONSOLE(dev);
+    if (request == 0x8006 && value == 0x0200 && index == 0) {
+        reply(p, data, length, config_descriptor, sizeof(config_descriptor));
+        return;
+    }
+    if (index == 0 && request == 0x8106 && value == 0x2200) {
+        reply(p, data, length, report_descriptor, sizeof(report_descriptor));
+        return;
+    }
+    if (index == 0 && request == 0x8106 && value == 0x2100) {
+        /* Core returns its unpatched static HID header on this request. */
+        static const uint8_t hid[] = {9, 0x21, 0x10, 1, 0, 1, 0x22, 0, 0};
+        reply(p, data, length, hid, sizeof(hid));
+        return;
+    }
+    if (usb_desc_handle_control(dev, p, request, value, index, length, data) >= 0) {
+        return;
+    }
+    if (index == 0) {
+        if (request == 0x2109 && value == 0x0202 && length == 2 && data[0] == 2) {
+            s->leds = data[1];
+            return;
+        }
+        if (request == 0x210b && length == 0 && value <= 255) {
+            s->protocol = value;
+            return;
+        }
+        /* This unusual standard-interface GET_PROTOCOL matches the pinned core. */
+        if (request == 0x8103 && length == 1) {
+            reply(p, data, length, &s->protocol, 1);
+            return;
+        }
+    }
+    if (index == 1) {
+        if (request == 0xa121 && value == 0) {
+            reply(p, data, length, s->line, sizeof(s->line));
+            return;
+        }
+        if (request == 0x2120 && value == 0 && length == 7) {
+            memcpy(s->line, data, 7);
+            return;
+        }
+        if (request == 0x2102 && length == 0) {
+            return; /* SET_COMM_FEATURE accepted but ignored by the core. */
+        }
+        if (request == 0x2122 && length == 0) {
+            bool dtr = value & 1;
+            s->control_lines = value & 3;
+            s->dtr_state = dtr ? 1 : (s->dtr_state == 1 ? 2 : 3);
+            if (s->dtr_state == 2 && ldl_le_p(s->line) == 1200) {
+                s->reset_requested = true;
+            }
+            return;
+        }
+    }
+    p->status = USB_RET_STALL;
+}
+
+static void uconsole_data(USBDevice *dev, USBPacket *p)
+{
+    UConsoleUSB *s = USB_UCONSOLE(dev);
+    unsigned ep = p->ep->nr;
+    if (p->pid == USB_TOKEN_IN && ep == 1) {
+        if (!s->count) {
+            p->status = USB_RET_NAK;
+            return;
+        }
+        if (p->iov.size < s->sizes[s->head]) {
+            p->status = USB_RET_BABBLE;
+            return;
+        }
+        usb_packet_copy(p, s->reports[s->head], s->sizes[s->head]);
+        s->head = (s->head + 1) % 32;
+        s->count--;
+        return;
+    }
+    if (p->pid == USB_TOKEN_OUT && ep == 2) {
+        /* Firmware does not consume CDC data in loop(); preserve backpressure. */
+        if (p->iov.size > 64) {
+            p->status = USB_RET_STALL;
+            return;
+        }
+        if (s->rx_used >= 192) {
+            p->status = USB_RET_NAK;
+            return;
+        }
+        usb_packet_copy(p, s->rx + s->rx_used, p->iov.size);
+        s->rx_used += p->iov.size;
+        if (s->dtr_state == 2) {
+            s->dtr_state = 3;
+            if (s->rx_used >= 4 && !memcmp(s->rx + s->rx_used - 4, "1EAF", 4)) {
+                s->reset_requested = true;
+            }
+        }
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && (ep == 2 || ep == 3)) {
+        p->status = USB_RET_NAK; /* No application CDC output or notifications. */
+        return;
+    }
+    p->status = USB_RET_STALL;
+}
+
+static void inject_report(Object *obj, const char *hex, Error **errp)
+{
+    UConsoleUSB *s = USB_UCONSOLE(obj);
+    uint8_t data[13];
+    unsigned length = strlen(hex), expected, slot;
+    if (length < 2 || length > 26 || length % 2) {
+        error_setg(errp, "Expected one hex HID report including its report ID");
+        return;
+    }
+    for (unsigned i = 0; i < length / 2; i++) {
+        int a = g_ascii_xdigit_value(hex[2 * i]);
+        int b = g_ascii_xdigit_value(hex[2 * i + 1]);
+        if (a < 0 || b < 0) {
+            error_setg(errp, "Invalid hex HID report");
+            return;
+        }
+        data[i] = a * 16 + b;
+    }
+    expected = data[0] == 1 ? 5 : data[0] == 2 ? 9 :
+               data[0] == 3 ? 3 : data[0] == 20 ? 13 : 0;
+    if (!expected || length / 2 != expected) {
+        error_setg(errp, "Incorrect report ID or size");
+        return;
+    }
+    if (USB_DEVICE(s)->configuration != 1 || s->count == 32) {
+        error_setg(errp, "Device is not configured or HID queue is full");
+        return;
+    }
+    slot = (s->head + s->count) % 32;
+    memcpy(s->reports[slot], data, expected);
+    s->sizes[slot] = expected;
+    s->count++;
+    usb_wakeup(usb_ep_get(USB_DEVICE(s), USB_TOKEN_IN, 1), 0);
+}
+
+static char *transport_state(Object *obj, Error **errp)
+{
+    UConsoleUSB *s = USB_UCONSOLE(obj);
+    return g_strdup_printf("queued=%u leds=%u cdc-rx=%u lines=%u reset-requested=%u configuration=%u epoch=%u",
+                           s->count, s->leds, s->rx_used,
+                           s->control_lines, s->reset_requested,
+                           USB_DEVICE(s)->configuration, s->epoch);
+}
+
+static void uconsole_realize(USBDevice *dev, Error **errp)
+{
+    UConsoleUSB *s = USB_UCONSOLE(dev);
+    static const uint8_t initial_line[] = {0, 0xc2, 1, 0, 0, 0, 8};
+    memcpy(s->line, initial_line, sizeof(initial_line));
+    usb_desc_init(dev);
+    uconsole_reset(dev);
+}
+
+static const VMStateDescription state = {
+    .name = "usb-uconsole-keyboard", .unmigratable = 1,
+};
+
+static void uconsole_class_init(ObjectClass *klass, const void *data)
+{
+    USBDeviceClass *uc = USB_DEVICE_CLASS(klass);
+    DEVICE_CLASS(klass)->vmsd = &state;
+    uc->product_desc = "uConsole keyboard (experimental composite transport)";
+    uc->usb_desc = &desc;
+    uc->realize = uconsole_realize;
+    uc->handle_reset = uconsole_reset;
+    uc->handle_control = uconsole_control;
+    uc->handle_data = uconsole_data;
+    object_class_property_add_str(klass, "inject-report", NULL, inject_report);
+    object_class_property_add_str(klass, "transport-state", transport_state, NULL);
+}
