+#define TYPE_USB_UCONSOLE "usb-uconsole-keyboard"
+OBJECT_DECLARE_SIMPLE_TYPE(UConsoleUSB, USB_UCONSOLE)
+
+struct UConsoleUSB {
+    USBDevice parent_obj;
+    uint8_t reports[32][13], sizes[32];
+    unsigned head, count, epoch;
+    uint8_t leds, protocol, line[7], control_lines, dtr_state;
+    uint8_t rx[256];
+    unsigned rx_used;
+    bool reset_requested;
+};
