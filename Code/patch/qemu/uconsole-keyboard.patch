+/*
+ * uConsole keyboard composite USB transport (functional model, not MCU emulation).
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Descriptor templates/report bytes: STM32F1 2021.2.22 compiled firmware
+ * df83700173c1fc180d59c8b01b710dc91e244c55af0f3c87f61edb6de5525c67.
+ * Runtime substitutions follow HID-first, CDC-second registration. No hardware
+ * capture qualification. Input state machine and bootloader are not implemented.
+ */
+#include "qemu/osdep.h"
