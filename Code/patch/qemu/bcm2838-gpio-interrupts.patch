+static void bcm2838_gpio_update_irq(BCM2838GpioState *s)
+{
+    uint32_t level[2] = { s->lev0, s->lev1 };
+    int bank;
+
+    for (bank = 0; bank < 2; bank++) {
+        s->events[bank] |= (level[bank] & s->detect[4 + bank]) |
+                          (~level[bank] & s->detect[6 + bank]);
+    }
+    qemu_set_irq(s->irq[0], !!(s->events[0] & 0x0fffffff));
+    qemu_set_irq(s->irq[1], !!((s->events[0] & 0xf0000000) |
+                              (s->events[1] & 0x00003fff)));
+    qemu_set_irq(s->irq[2], !!(s->events[1] & 0x03ffc000));
+    qemu_set_irq(s->irq[3], !!(s->events[0] | s->events[1]));
+}
+
+static void bcm2838_gpio_update_levels(BCM2838GpioState *s)
+{
+    uint32_t previous[2] = { s->lev0, s->lev1 };
+    uint32_t level[2] = { s->input[0], s->input[1] };
+    int pin, bank;
+
+    for (pin = 0; pin < BCM2838_GPIO_NUM; pin++) {
+        uint32_t bit = BIT(pin % 32);
+        bank = pin / 32;
+        if (s->fsel[pin] == BCM2838_FSEL_GPIO_OUT) {
+            level[bank] = (level[bank] & ~bit) | (s->latch[bank] & bit);
+            if ((s->driven[bank] ^ level[bank]) & bit) {
+                s->driven[bank] ^= bit;
+                qemu_set_irq(s->out[pin], !!(level[bank] & bit));
+            }
+        }
+    }
+    for (bank = 0; bank < 2; bank++) {
+        /* Digital edges only: synchronous clock/glitch filtering is absent. */
+        s->events[bank] |= (~previous[bank] & level[bank] &
+                           (s->detect[bank] | s->detect[8 + bank])) |
+                          (previous[bank] & ~level[bank] &
+                           (s->detect[2 + bank] | s->detect[10 + bank]));
+    }
+    s->lev0 = level[0];
+    s->lev1 = level[1];
+    bcm2838_gpio_update_irq(s);
+}
+
+static void bcm2838_gpio_input(void *opaque, int pin, int level)
+{
+    BCM2838GpioState *s = opaque;
+    uint32_t bit = BIT(pin % 32);
+
+    if (level) {
+        s->input[pin / 32] |= bit;
+    } else {
+        s->input[pin / 32] &= ~bit;
+    }
+    bcm2838_gpio_update_levels(s);
+}
