+static int bcm2838_gpio_post_load(void *opaque, int version_id)
+{
+    BCM2838GpioState *s = opaque;
+
+    if (version_id == 1) {
+        memset(s->events, 0, sizeof(s->events));
+        memset(s->detect, 0, sizeof(s->detect));
+        s->input[0] = s->latch[0] = s->lev0;
+        s->input[1] = s->latch[1] = s->lev1;
+    }
+    bcm2838_gpio_update_levels(s);
+    return 0;
+}
