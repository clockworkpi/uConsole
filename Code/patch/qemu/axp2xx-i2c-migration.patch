     .name = TYPE_AXP2XX,
-    .version_id = 2,
+    .version_id = 3,
     .minimum_version_id = 1,
     .post_load = axp2xx_post_load,
     .fields = (const VMStateField[]) {
@@ -524,6 +530,7 @@
         VMSTATE_UINT8(ptr, AXP2xxI2CState),
         VMSTATE_UINT8(count, AXP2xxI2CState),
         VMSTATE_BOOL_V(key_pressed, AXP2xxI2CState, 2),
+        VMSTATE_STRUCT(i2c, AXP2xxI2CState, 3, vmstate_i2c_slave, I2CSlave),
         VMSTATE_END_OF_LIST()
     }
 };
