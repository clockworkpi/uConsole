--- a/hw/misc/axp2xx.c
+++ b/hw/misc/axp2xx.c
@@ -505,6 +505,12 @@
 {
     AXP2xxI2CState *s = opaque;
 
+    /* Prototype AXP221 streams omitted the active I2C slave state. Do not
+     * silently accept them as a recoverable in-flight transaction. Keep the
+     * older AXP209 compatibility policy unchanged. */
+    if (version_id < 3 && AXP2XX_GET_CLASS(s)->irq_model) {
+        return -EINVAL;
+    }
     if (version_id < 2) {
         s->key_pressed = false;
     }
