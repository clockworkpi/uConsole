--- a/hw/misc/bcm2835_property.c
+++ b/hw/misc/bcm2835_property.c
@@ -23,6 +23,55 @@
 
 /* https://github.com/raspberrypi/firmware/wiki/Mailbox-property-interface */
 
+static size_t bcm2835_property_gpio(BCM2835PropertyState *s, uint32_t tag,
+                                   uint32_t value, uint32_t bufsize)
+{
+    uint32_t pin, fields[5];
+    unsigned count, i;
+    uint32_t *config;
+
+    /*
+     * Layout and success status follow drivers/gpio/gpio-raspberrypi-exp.c.
+     * GPIO IDs 128..135 are distinct from the SoC GPIO controller.
+     */
+    count = tag == RPI_FWREQ_SET_GPIO_CONFIG ? 6 :
+            tag == RPI_FWREQ_GET_GPIO_CONFIG ? 5 : 2;
+    if (bufsize < count * sizeof(uint32_t)) {
+        return 0;
+    }
+    pin = ldl_le_phys(&s->dma_as, value + 12);
+    if (pin < 128 || pin >= 136) {
+        stl_le_phys(&s->dma_as, value + 12, UINT32_MAX);
+        return count * sizeof(uint32_t);
+    }
+    config = &s->exp_gpio[(pin - 128) * 5];
+    if (tag == RPI_FWREQ_SET_GPIO_CONFIG) {
+        for (i = 0; i < 5; i++) {
+            fields[i] = ldl_le_phys(&s->dma_as, value + 16 + i * 4);
+            if (fields[i] > 1) {
+                stl_le_phys(&s->dma_as, value + 12, UINT32_MAX);
+                return count * sizeof(uint32_t);
+            }
+        }
+        memcpy(config, fields, sizeof(fields));
+    } else if (tag == RPI_FWREQ_GET_GPIO_CONFIG) {
+        for (i = 0; i < 4; i++) {
+            stl_le_phys(&s->dma_as, value + 16 + i * 4, config[i]);
+        }
+    } else if (tag == RPI_FWREQ_SET_GPIO_STATE) {
+        uint32_t state = ldl_le_phys(&s->dma_as, value + 16);
+        if (state > 1) {
+            stl_le_phys(&s->dma_as, value + 12, UINT32_MAX);
+            return count * sizeof(uint32_t);
+        }
+        config[4] = state;
+    } else {
+        stl_le_phys(&s->dma_as, value + 16, config[4]);
+    }
+    stl_le_phys(&s->dma_as, value + 12, 0);
+    return count * sizeof(uint32_t);
+}
+
 static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
 {
     uint32_t tot_len;
@@ -51,6 +100,16 @@
         switch (tag) {
