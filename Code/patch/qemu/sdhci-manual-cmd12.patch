 }
 
+/* SDMA runs synchronously until a buffer boundary. Outside the transfer
+ * function an active SDMA data phase is waiting for a System Address write. */
+static bool sdhci_sdma_in_progress(SDHCIState *s)
+{
+    return (s->trnmod & SDHC_TRNS_DMA) &&
+           (s->prnsts & SDHC_DATA_INHIBIT) &&
+           SDHC_DMA_TYPE(s->hostctl1) == SDHC_CTRL_SDMA;
+}
+
 static void
 sdhci_write(void *opaque, hwaddr offset, uint64_t val, unsigned size)
 {
@@ -1184,13 +1212,13 @@
 
     switch (offset & ~0x3) {
     case SDHC_SYSAD:
-        if (!TRANSFERRING_DATA(s->prnsts)) {
+        if (!TRANSFERRING_DATA(s->prnsts) || sdhci_sdma_in_progress(s)) {
             s->sdmasysad = (s->sdmasysad & mask) | value;
             MASKED_WRITE(s->sdmasysad, mask, value);
             /* Writing to last byte of sdmasysad might trigger transfer */
             if (!(mask & 0xFF000000) && s->blkcnt &&
                 (s->blksize & BLOCK_SIZE_MASK) &&
-                SDHC_DMA_TYPE(s->hostctl1) == SDHC_CTRL_SDMA) {
+                sdhci_sdma_in_progress(s)) {
                 sdhci_sdma_transfer(s);
             }
         }
