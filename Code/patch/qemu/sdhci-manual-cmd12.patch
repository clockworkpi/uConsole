--- a/hw/sd/sdhci.c
+++ b/hw/sd/sdhci.c
@@ -333,6 +333,20 @@
 
 #define BLOCK_SIZE_MASK (4 * KiB - 1)
 
+static void sdhci_complete_data_transfer(SDHCIState *s)
+{
+    timer_del(s->transfer_timer);
+    s->prnsts &= ~(SDHC_DOING_READ | SDHC_DOING_WRITE |
+            SDHC_DAT_LINE_ACTIVE | SDHC_DATA_INHIBIT |
+            SDHC_SPACE_AVAILABLE | SDHC_DATA_AVAILABLE);
+
+    if (s->norintstsen & SDHC_NISEN_TRSCMP) {
+        s->norintsts |= SDHC_NIS_TRSCMP;
+    }
+
+    sdhci_update_irq(s);
+}
+
 static void sdhci_send_command(SDHCIState *s)
 {
     SDRequest request;
@@ -383,6 +397,18 @@
 
     sdhci_update_irq(s);
 
+    /* A successful explicit STOP_TRANSMISSION ends the host data phase too.
+     * The card has already accepted CMD12; do not run AutoCMD12 a second time.
+     * Discard any prefetched/partial FIFO and block-gap continuation state. */
+    if (!timeout && request.cmd == 12 &&
+        SDHC_COMMAND_TYPE(s->cmdreg) == SDHC_CMD_ABORT) {
+        s->data_count = 0;
+        s->stopped_state = sdhc_not_stopped;
+        s->blkgap &= ~(SDHC_STOP_AT_GAP_REQ | SDHC_CONTINUE_REQ);
+        sdhci_complete_data_transfer(s);
+        return;
+    }
+
     if (!timeout && (s->blksize & BLOCK_SIZE_MASK) &&
         (s->cmdreg & SDHC_CMD_DATA_PRESENT)) {
         s->data_count = 0;
@@ -405,15 +431,7 @@
         s->rspreg[3] = ldl_be_p(response);
     }
 
-    s->prnsts &= ~(SDHC_DOING_READ | SDHC_DOING_WRITE |
-            SDHC_DAT_LINE_ACTIVE | SDHC_DATA_INHIBIT |
-            SDHC_SPACE_AVAILABLE | SDHC_DATA_AVAILABLE);
-
-    if (s->norintstsen & SDHC_NISEN_TRSCMP) {
-        s->norintsts |= SDHC_NIS_TRSCMP;
-    }
-
-    sdhci_update_irq(s);
+    sdhci_complete_data_transfer(s);
 }
 
