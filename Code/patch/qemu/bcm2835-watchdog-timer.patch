--- a/hw/misc/bcm2835_powermgt.c
+++ b/hw/misc/bcm2835_powermgt.c
@@ -23,6 +23,30 @@
 #define R_RSTS 0x20
 #define V_RSTS_POWEROFF 0x555 /* Linux uses partition 63 to indicate halt. */
 #define R_WDOG 0x24
+#define WDOG_MASK 0xfffff
+
+static void bcm2835_powermgt_expire(void *opaque)
+{
+    BCM2835PowerMgtState *s = opaque;
+
+    s->wdog = 0;
+    if ((s->rsts & 0x555) == V_RSTS_POWEROFF) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    } else {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
+
+static void bcm2835_powermgt_reload(BCM2835PowerMgtState *s)
+{
+    if (s->rstc & V_RSTC_RESET) {
+        /* The 20-bit watchdog counts at 65536 Hz. Arming is not a reset. */
+        timer_mod(&s->watchdog, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  ((uint64_t)s->wdog * NANOSECONDS_PER_SECOND + 65535) / 65536);
+    } else {
+        timer_del(&s->watchdog);
+    }
+}
 
 static uint64_t bcm2835_powermgt_read(void *opaque, hwaddr offset,
                                       unsigned size)
@@ -39,6 +63,12 @@
         break;
     case R_WDOG:
         res = s->wdog;
