+            int64_t left = timer_expire_time_ns(&s->watchdog) -
+                           qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            res = (MAX(left, 0) * 65536 + NANOSECONDS_PER_SECOND - 1) /
+                  NANOSECONDS_PER_SECOND;
+        }
         break;
 
     default:
@@ -70,13 +100,7 @@
