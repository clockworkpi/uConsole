+static void axp221_get_temperature(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int64_t mc = (((s->regs[0x56] << 4) | s->regs[0x57]) - 2677) * 100;
+
+    visit_type_int(v, name, &mc, errp);
+}
+
+static void axp221_set_temperature(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int64_t mc;
+    unsigned raw;
+
+    if (!visit_type_int(v, name, &mc, errp)) {
+        return;
+    }
+    if (mc < -267700 || mc > 141800) {
+        error_setg(errp, "PMIC temperature must be -267700..141800 millidegrees C");
+        return;
+    }
+    /* Sampled 12-bit ADC input, 100 mC/LSB; no conversion clock or faults. */
+    raw = (mc + 267700) / 100;
+    s->regs[0x56] = raw >> 4;
+    s->regs[0x57] = raw & 15;
+}
+
+static void axp221_init(Object *obj)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+
+    /* Preserve external AC state across reset; default to connected. */
+    s->regs[0x00] = AXP221_PWR_STATUS_ACIN_PRESENT;
+    s->regs[0xb9] = 100;
+    s->regs[0x56] = 2927 >> 4; /* Default 25 degrees C. */
+    s->regs[0x57] = 2927 & 15;
+    qdev_init_gpio_out(DEVICE(obj), &s->irq, 1);
+    object_property_add_bool(obj, "ac-present", axp221_get_ac, axp221_set_ac);
+    object_property_add_bool(obj, "battery-present",
+                             axp221_get_battery, axp221_set_battery);
+    object_property_add(obj, "battery-voltage-uv", "int",
+                        axp221_get_voltage, axp221_set_voltage, NULL, NULL);
+    object_property_add(obj, "battery-current-ma", "int",
+                        axp221_get_current, axp221_set_current, NULL, NULL);
+    object_property_add(obj, "battery-capacity", "int",
+                        axp221_get_capacity, axp221_set_capacity, NULL, NULL);
+    object_property_add(obj, "pmic-temperature-mc", "int",
+                        axp221_get_temperature, axp221_set_temperature, NULL, NULL);
+    object_property_add_bool(obj, "pmic-over-temperature",
+                             axp221_get_over_temperature, axp221_set_over_temperature);
+    object_property_add_bool(obj, "irq-active", axp221_irq_active, NULL);
+    object_property_add_bool(obj, "power-key-pressed", axp221_get_key, axp221_set_key);
 }
 
