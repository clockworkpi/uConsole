+static bool axp221_irq_active(Object *obj, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int i;
+
+    for (i = 0; i < 5; i++) {
+        if (s->regs[0x40 + i] & s->regs[0x48 + i]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void axp221_update_irq(AXP2xxI2CState *s)
+{
+    /* Logical assertion; board wiring must invert for the active-low pin. */
+    qemu_set_irq(s->irq, axp221_irq_active(OBJECT(s), NULL));
+}
+
+static bool axp221_get_over_temperature(Object *obj, Error **errp)
+{
+    return AXP2XX(obj)->regs[0x01] & BIT(7);
+}
+
+static void axp221_thermal_shutdown(AXP2xxI2CState *s)
+{
+    if ((s->regs[0x01] & BIT(7)) && (s->regs[0x8f] & BIT(2))) {
+        /* Abrupt PMIC power removal, not a guest-requested clean shutdown. */
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_ERROR);
+    }
+}
+
+static void axp221_set_over_temperature(Object *obj, bool active, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    bool previous = axp221_get_over_temperature(obj, NULL);
+
+    s->regs[0x01] = (s->regs[0x01] & ~BIT(7)) | (active ? BIT(7) : 0);
+    if (active && !previous) {
+        s->regs[0x4a] |= BIT(7);
+    }
+    axp221_update_irq(s);
+    axp221_thermal_shutdown(s);
+}
+
+static bool axp221_get_key(Object *obj, Error **errp)
+{
+    return AXP2XX(obj)->key_pressed;
+}
+
+static void axp221_set_key(Object *obj, bool pressed, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+
+    if (s->key_pressed == pressed) {
+        return;
+    }
+    s->key_pressed = pressed;
+    /* PEK is active low: falling means pressed, rising means released. */
+    s->regs[0x4c] |= pressed ? BIT(5) : BIT(6);
+    axp221_update_irq(s);
+}
+
+static bool axp221_get_ac(Object *obj, Error **errp)
+{
+    return AXP2XX(obj)->regs[0x00] & AXP221_PWR_STATUS_ACIN_PRESENT;
+}
+
+static int axp221_current(AXP2xxI2CState *s)
+{
+    return ((s->regs[0x7a] << 4) | (s->regs[0x7b] & 15)) -
+           ((s->regs[0x7c] << 4) | (s->regs[0x7d] & 15));
+}
+
+static void axp221_store_current(AXP2xxI2CState *s, int ma, bool events)
+{
+    bool charging = s->regs[0x00] & BIT(2);
+    unsigned charge = ma > 0 ? ma : 0;
+    unsigned discharge = ma < 0 ? -ma : 0;
+
+    s->regs[0x7a] = charge >> 4;
+    s->regs[0x7b] = charge & 15;
+    s->regs[0x7c] = discharge >> 4;
+    s->regs[0x7d] = discharge & 15;
+    s->regs[0x00] = (s->regs[0x00] & ~BIT(2)) | (ma > 0 ? BIT(2) : 0);
+    s->regs[0x01] = (s->regs[0x01] & ~BIT(6)) | (ma > 0 ? BIT(6) : 0);
+    if (events && ma > 0 && !charging) {
+        s->regs[0x49] |= BIT(3); /* Charging started. */
+    }
+    axp221_update_irq(s);
+}
+
+static void axp221_get_current(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    int64_t ma = axp221_current(AXP2XX(obj));
+    visit_type_int(v, name, &ma, errp);
+}
+
+static void axp221_set_current(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int64_t ma;
+
+    if (!visit_type_int(v, name, &ma, errp)) {
+        return;
+    }
+    if (ma < -4095 || ma > 4095 || (ma && !(s->regs[1] & BIT(5))) ||
+        (ma > 0 && (!axp221_get_ac(obj, NULL) || !(s->regs[0x33] & BIT(7)) ||
+                    (s->regs[0xb9] & 127) == 100))) {
+        error_setg(errp, "Current must be -4095..4095 mA; nonzero needs a "
+                   "battery; charging needs AC, enabled charger and capacity <100");
+        return;
+    }
+    axp221_store_current(s, ma, true);
+}
+
+/* Sampled warning conditions; analogue fuel-gauge timing is not modeled. */
+static uint8_t axp221_low_conditions(AXP2xxI2CState *s)
+{
+    unsigned capacity = s->regs[0xb9] & 127;
+    unsigned warning1 = (s->regs[0xe6] >> 4) + 5;
+    unsigned warning2 = s->regs[0xe6] & 15;
+
+    if (!(s->regs[1] & BIT(5)) || !(s->regs[0xb8] & BIT(7)) ||
+        !(s->regs[0xb9] & BIT(7))) {
+        return 0;
+    }
+    return (capacity < warning1 ? BIT(1) : 0) |
+           (capacity < warning2 ? BIT(0) : 0);
+}
+
+static void axp221_update_low(AXP2xxI2CState *s, uint8_t previous)
+{
+    /* Latch newly entered conditions, even when the IRQ is masked. */
+    s->regs[0x4b] |= axp221_low_conditions(s) & ~previous;
+    axp221_update_irq(s);
+}
+
+static void axp221_get_capacity(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    int64_t capacity = AXP2XX(obj)->regs[0xb9] & 127;
+    visit_type_int(v, name, &capacity, errp);
+}
+
+static void axp221_set_capacity(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int64_t capacity;
+    uint8_t previous = axp221_low_conditions(s);
+
+    if (!visit_type_int(v, name, &capacity, errp)) {
+        return;
+    }
+    if (capacity < 0 || capacity > 100) {
+        error_setg(errp, "battery-capacity must be in 0..100 percent");
+        return;
+    }
+    s->regs[0xb9] = capacity | ((s->regs[1] & BIT(5)) ? BIT(7) : 0);
+    if (capacity == 100 && axp221_current(s) > 0) {
+        s->regs[0x49] |= BIT(2); /* Charge completed, not mere charger disable. */
+        axp221_store_current(s, 0, false);
+    }
+    axp221_update_low(s, previous);
+}
+
+static void axp221_set_ac(Object *obj, bool present, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    const uint8_t mask = AXP221_PWR_STATUS_ACIN_PRESENT |
+                         AXP221_PWR_STATUS_ACIN_AVAIL |
+                         AXP221_PWR_STATUS_ACIN_VBUS_POWERED;
+
+    if (present == axp221_get_ac(obj, NULL)) {
+        return;
+    }
+    s->regs[0x00] = (s->regs[0x00] & ~mask) | (present ? mask : 0);
+    /* ACIN_PLUGIN / ACIN_REMOVAL latch even when their IRQ is masked. */
+    s->regs[0x48] |= present ? BIT(6) : BIT(5);
+    if (!present && axp221_current(s) > 0) {
+        axp221_store_current(s, 0, false);
+    }
+    axp221_update_irq(s);
+}
+
+static void axp221_get_voltage(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int64_t uv = ((s->regs[0x78] << 4) | (s->regs[0x79] & 15)) * 1100;
+
+    visit_type_int(v, name, &uv, errp);
+}
+
+static void axp221_set_voltage(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    int64_t uv;
+
+    if (!visit_type_int(v, name, &uv, errp)) {
+        return;
+    }
+    if (uv < 0 || uv > 4095 * 1100) {
+        error_setg(errp, "battery-voltage-uv must be in 0..4504500");
+        return;
+    }
+    /* Inject a sampled 12-bit reading, rounded down to 1.1mV steps. */
+    uv /= 1100;
+    s->regs[0x78] = uv >> 4;
+    s->regs[0x79] = uv & 15;
+}
+
+static bool axp221_get_battery(Object *obj, Error **errp)
+{
+    return AXP2XX(obj)->regs[0x01] & BIT(5);
+}
+
+static void axp221_set_battery(Object *obj, bool present, Error **errp)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+    uint8_t previous = axp221_low_conditions(s);
+
+    if (present == axp221_get_battery(obj, NULL)) {
+        return;
+    }
+    s->regs[0x01] = (s->regs[0x01] & ~BIT(5)) | (present ? BIT(5) : 0);
+    s->regs[0x49] |= present ? BIT(7) : BIT(6);
+    s->regs[0xb9] = (s->regs[0xb9] & 127) | (present ? BIT(7) : 0);
+    if (!present) {
+        axp221_store_current(s, 0, false);
+    }
+    axp221_update_low(s, previous);
+}
+
