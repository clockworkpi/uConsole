+static int axp2xx_post_load(void *opaque, int version_id)
+{
+    AXP2xxI2CState *s = opaque;
+
+    if (version_id < 2) {
+        s->key_pressed = false;
+    }
+    if (AXP2XX_GET_CLASS(s)->irq_model) {
+        axp221_update_irq(s);
+    }
+    return 0;
+}
